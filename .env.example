# Skopiuj do .env.local i uzupełnij. Nigdy nie commituj prawdziwych kluczy.
# Brak zmiennej = tryb testowy: strona pokazuje stan „nie uruchomione” zamiast udawać działanie.

# Adres publiczny sklepu (metadane, linki w e-mailach, powrót ze Stripe).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Płatności (Stripe Checkout, PLN) ---
# Klucz tajny z Dashboardu Stripe (tryb testowy: sk_test_...).
STRIPE_SECRET_KEY=
# Sekret punktu końcowego webhooka (whsec_...). Endpoint: /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Opcjonalnie: ID konfiguracji metod płatności z Dashboardu (karta, BLIK, Przelewy24).
STRIPE_PAYMENT_METHOD_CONFIGURATION=

# --- InPost: wybór paczkomatu (Geowidget) ---
# Publiczny token z Parcel Managera (zakładka API → Geowidget). Dla domeny, na której działa sklep.
NEXT_PUBLIC_INPOST_GEOWIDGET_TOKEN=

# --- InPost: tworzenie przesyłek (ShipX) ---
INPOST_API_TOKEN=
INPOST_ORGANIZATION_ID=
# Produkcja: https://api-shipx-pl.easypack24.net (domyślnie). Sandbox: https://sandbox-api-shipx-pl.easypack24.net
INPOST_API_BASE=

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Opcjonalnie: lokalizacja pliku zamówień (domyślnie .data/orders.json) ---
ORDER_STORE_PATH=
